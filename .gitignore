*.bt2l
*.k2d
*.dmnd
*.hmm
*.h3f
*.h3i
*.h3m
*.h3p
db/
databases/
ref/
kraken2_db/
metaphlan_db/
humann_db/
gtdbtk_data/

# ---------- 대용량 중간 산출물 ----------
data/raw/
data/interim/
work/
tmp/
scratch/
*_assembly/
spades_out/
metaspades_out/
bins/
checkm*/
